{
  // ──────────────────────────────────────────────────────────────
  // Cloudflare Workers 설정 (정적 사이트 + 주간 랭킹 API + 자동삭제 크론)
  //
  // 최초 1회 설정 (터미널에서):
  //   1) npm i -g wrangler && wrangler login
  //   2) wrangler d1 create primal-rankings
  //      → 출력된 database_id를 아래 d1_databases.database_id 에 붙여넣기
  //   3) wrangler r2 bucket create primal-ranking-photos
  //   4) wrangler d1 execute primal-rankings --remote --file=./schema.sql
  //   5) wrangler deploy
  //
  // 로컬 테스트:  wrangler dev   (D1/R2 로컬 에뮬레이션)
  // ──────────────────────────────────────────────────────────────
  "name": "cavemanify1",
  "main": "worker.js",
  "compatibility_date": "2026-02-15",

  // primal-type.com 은 Pages가 서빙하므로, 랭킹 API는 api 서브도메인으로 분리
  "routes": [
    { "pattern": "api.primal-type.com", "custom_domain": true }
  ],

  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "primal-rankings",
      "database_id": "0e8fe06f-329a-42f3-85e8-2f1c67169b3c"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "primal-ranking-photos"
    }
  ],

  "triggers": {
    // 매주 월요일 00:00 UTC = 한국시간 월요일 오전 9시(09:00 KST)에 지난 주 랭킹/사진 자동 삭제.
    // 표시되는 랭킹도 이 시점에 ISO 주차가 바뀌며 새 주차(빈 랭킹)로 자동 초기화됨.
    "crons": ["0 0 * * 1"]
  }
}
